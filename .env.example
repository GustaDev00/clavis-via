# Copie para .env.local e preencha.
# Local: rode `pnpm db:start` e use os valores de `pnpm db:status` (API_URL e PUBLISHABLE_KEY).
# Produção: as variáveis vêm da integração Supabase da Vercel (Marketplace).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
