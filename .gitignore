# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ferramentas locais de agentes (skills instaladas pela integração da Vercel, preview do Claude)
/.claude
/.agents
skills-lock.json

# testes E2E
/playwright-report
/test-results
/blob-report

# exemplo de variáveis (sem segredos) é versionado
!.env.example

# material de estudo pessoal (não faz parte da entrega)
/docs/privado
